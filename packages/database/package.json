{
  "name": "@an30/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations",
    "verification"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node scripts/clean-dist.mjs",
    "lint": "eslint src",
    "migrate": "node dist/migrate.js up",
    "migrate:status": "node dist/migrate.js status",
    "prebuild": "pnpm clean",
    "seed:dev": "node dist/seed.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pg": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
