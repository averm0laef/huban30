# Runtime
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
AN30_SECRETS_DIR=./secrets
API_BASE_URL=http://localhost:4000/api/v1
INTERNAL_API_URL=http://localhost:4000
SITE_ADDRESS=http://localhost
WWW_SITE_ADDRESS=http://www.localhost
ACME_EMAIL=admin@an30.ru
TRUST_PROXY_CIDRS=
# Compose gives the two trusted proxies fixed addresses in its private network.
AN30_BACKEND_SUBNET=172.30.30.0/24
AN30_CADDY_PROXY_IP=172.30.30.10
AN30_WEB_PROXY_IP=172.30.30.11
AUTH_DEBUG_TOKENS=true
COOKIE_SECURE=false
# API without Docker: listen address and the browser origin it trusts (CORS,
# CSRF, social login redirect). Compose sets API_BIND_HOST=0.0.0.0 inside the
# container and derives APP_ORIGIN from APP_BASE_URL.
API_BIND_HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000

# Temporary legacy Vite bridge. Removed after the autonomous API replaces it.
VITE_SUPABASE_PROJECT_ID=local-placeholder
VITE_SUPABASE_PUBLISHABLE_KEY=local-placeholder
VITE_SUPABASE_URL=http://127.0.0.1:54321

# PostgreSQL and Redis
DATABASE_ENVIRONMENT=development
DATABASE_URL=postgresql://an30:change-me@localhost:5432/an30
APP_DB_USER=an30_app
APP_POSTGRES_PASSWORD_FILE=/run/secrets/app_database_password
REDIS_URL=redis://localhost:6379

# Secret files. Real values live outside the repository.
SESSION_SECRET_FILE=/run/secrets/session_secret
DATA_ENCRYPTION_KEY_FILE=/run/secrets/data_encryption_key

# Storage
STORAGE_DRIVER=local
STORAGE_ROOT=/data/uploads

# Checkout creates a заявка (manager request) -- no payment gateway. It is
# intentionally closed until the legal documents are approved.
ENABLE_PUBLIC_CHECKOUT=false
LEGAL_DOCUMENTS_APPROVED=false
YANDEX_ID_CLIENT_ID=
VK_ID_CLIENT_ID=
DEPLOYMENT_ENVIRONMENT=development

# Rossko supplier search ("под заказ"). Disabled until real API keys exist.
ROSSKO_ENABLED=false
ROSSKO_DELIVERY_ID=000000001
ROSSKO_KEY1_FILE=/run/secrets/rossko_key1
ROSSKO_KEY2_FILE=/run/secrets/rossko_key2
# Retail margin in percent added to every supplier price on the server.
SUPPLIER_MARKUP_PERCENT=30

# Optional external catalog identity checks for staff. Does not replace 1C.
REEFAPI_ENABLED=false
REEFAPI_KEY_FILE=/run/secrets/reefapi_key
REEFAPI_MARKET=de
REEFAPI_DAILY_CREDITS=30

# Gemini-backed chat assistant. Disabled until a real API key exists; the
# shop and chat work fully without it (ADR-004), and catalog search ranking
# never changes based on this flag (ADR-016).
AI_ENABLED=false
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key

# Optional integrations
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD_FILE=/run/secrets/smtp_password
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
TELEGRAM_CHAT_ID=
VK_ENABLED=false
VK_ACCESS_TOKEN_FILE=/run/secrets/vk_access_token
VK_PEER_ID=

# 1C: точное название вида цен, который показывается на сайте (например «Оптовая цена»).
# Если не задано, сайт сам берёт вид цен продажи: с «розн» в названии, иначе первый по списку;
# себестоимость («Учетная», «Закупочная») не берётся никогда. См. docs/ONE_C_SETUP_UNF.md, раздел 5.2.
ONE_C_PRICE_TYPE=
ONE_C_PRICE_TYPE_SECONDARY=

# Optional external search engine (docs/SEARCH_ENGINE.md). Off by default:
# PostgreSQL answers every search and stays the fallback when it is on.
SEARCH_ENGINE=postgres
OPENSEARCH_URL=
OPENSEARCH_INDEX=an30-products
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD_FILE=
OPENSEARCH_TIMEOUT_MS=800

# Подбор по автомобилю / VIN (docs/PARTS_FINDER.md). Works without keys (Probox
# reference, shop fitment, LADA VIN rules, NHTSA vPIC, VINROKU). FAPI and
# API Ninjas keys are optional secret files.
PARTS_FINDER_ENABLED=true
FAPI_KEY_FILE=/run/secrets/fapi_key
FAPI_FITMENT_ENABLED=false
FAPI_DAILY_CREDIT_LIMIT=1000
# One visitor's share of the day's credits (by address). Beyond it the finder answers that visitor from the shop's own data.
FAPI_VISITOR_DAILY_CREDIT_LIMIT=100
API_NINJAS_KEY_FILE=/run/secrets/api_ninjas_key
API_NINJAS_MODE=off

# TecDoc (tecdoc.site) — каталог автомобилей и применимости, см. docs/TECDOC.md.
# Ключ кладётся в файл секрета tecdoc_api_key.txt; без ключа сайт работает на своём справочнике.
TECDOC_ENABLED=true
# Купленный пакет (запросов на 30 дней) и дата его покупки (ГГГГ-ММ-ДД).
TECDOC_MONTHLY_LIMIT=150000
TECDOC_PERIOD_START=
# 0 = автоматически: остаток пакета делится поровну на оставшиеся дни; в час не больше пятой части дня.
# Для тестового ключа (500 запросов в сутки) поставьте TECDOC_DAILY_LIMIT=450.
TECDOC_DAILY_LIMIT=0
TECDOC_HOURLY_LIMIT=0
# Сколько запросов к каталогу может вызвать один посетитель за сутки.
TECDOC_VISITOR_DAILY_LIMIT=150
# Кеш показа: по умолчанию сутки и не больше 20 000 ответов. Увеличивать только с письменного согласия tecdoc.site.
TECDOC_CACHE_TTL_SECONDS=86400
TECDOC_CACHE_MAX_ENTRIES=20000
