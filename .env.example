# Runtime
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
AN30_SECRETS_DIR=./secrets
API_BASE_URL=http://localhost:4000/api/v1
INTERNAL_API_URL=http://localhost:4000
SITE_ADDRESS=http://localhost
WWW_SITE_ADDRESS=http://www.localhost
ACME_EMAIL=admin@an30.ru
TRUST_PROXY_HOPS=0
AUTH_DEBUG_TOKENS=true
COOKIE_SECURE=false

# Temporary legacy Vite bridge. Removed after the autonomous API replaces it.
VITE_SUPABASE_PROJECT_ID=local-placeholder
VITE_SUPABASE_PUBLISHABLE_KEY=local-placeholder
VITE_SUPABASE_URL=http://127.0.0.1:54321

# PostgreSQL and Redis
DATABASE_ENVIRONMENT=development
DATABASE_URL=postgresql://an30:change-me@localhost:5432/an30
APP_DB_USER=an30_app
APP_POSTGRES_PASSWORD_FILE=/run/secrets/app_database_password
REDIS_URL=redis://localhost:6379

# Secret files. Real values live outside the repository.
SESSION_SECRET_FILE=/run/secrets/session_secret
DATA_ENCRYPTION_KEY_FILE=/run/secrets/data_encryption_key

# Storage
STORAGE_DRIVER=local
STORAGE_ROOT=/data/uploads

# Checkout is intentionally closed until a production payment provider is ready.
PAYMENTS_PROVIDER=sandbox
ENABLE_PUBLIC_CHECKOUT=false
LEGAL_DOCUMENTS_APPROVED=false
DEPLOYMENT_ENVIRONMENT=development
RESERVATION_TTL_MINUTES=20
SANDBOX_PAYMENT_WEBHOOK_SECRET_FILE=/run/secrets/sandbox_payment_webhook_secret

# Rossko supplier search ("под заказ"). Disabled until real API keys exist.
ROSSKO_ENABLED=false
ROSSKO_DELIVERY_ID=000000001
ROSSKO_KEY1_FILE=/run/secrets/rossko_key1
ROSSKO_KEY2_FILE=/run/secrets/rossko_key2

# Gemini-backed chat assistant. Disabled until a real API key exists; the
# shop and chat work fully without it (ADR-004), and catalog search ranking
# never changes based on this flag (ADR-016).
AI_ENABLED=false
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key

# Optional integrations
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD_FILE=/run/secrets/smtp_password
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
TELEGRAM_CHAT_ID=
VK_ENABLED=false
VK_ACCESS_TOKEN_FILE=/run/secrets/vk_access_token
VK_PEER_ID=
