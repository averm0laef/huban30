{
  "name": "@an30/monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @an30/messaging... build && pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "db:migrate": "pnpm --filter @an30/database build && pnpm --filter @an30/database migrate",
    "db:seed:dev": "pnpm --filter @an30/database build && pnpm --filter @an30/database seed:dev",
    "db:status": "pnpm --filter @an30/database build && pnpm --filter @an30/database migrate:status",
    "lint": "eslint tests playwright.config.ts playwright.mobile.config.ts && pnpm -r --if-present run lint",
    "typecheck": "pnpm --filter @an30/messaging... build && tsc -p tsconfig.node.json --noEmit && pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --config playwright.mobile.config.ts",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:full": "pnpm verify && pnpm test:e2e && pnpm audit:prod"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
