{
	email {$ACME_EMAIL}
	admin off
	# The limiter stands before the site password: a flood is turned away before any password is checked.
	order rate_limit before basic_auth
	servers {
		# A connection that opens and then says nothing (or drips its headers) is dropped; an idle one is closed.
		timeouts {
			read_header 10s
			idle 2m
		}
		max_header_size 32KB
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip
	request_body {
		# 15 MiB chat media plus multipart framing; the API remains the final
		# authority with its exact 16 MiB body limit.
		max_size 17MB
	}

	# Frequent requests from one address. Measured on the full catalogue (23.11.2026): one brisk visitor makes about
	# 12 page renders and 25 API calls a minute, and ~500 link prefetches — those are answered in a few hundred bytes
	# without touching the database, so they are not counted. The limits leave room for a dozen customers behind one
	# address of a mobile carrier and stop one address from taking the server's whole capacity. Windows are short
	# and counts small on purpose: the limiter keeps `events` timestamps per address, and a flood from many addresses
	# must not be able to fill the proxy's memory. The API keeps its own, finer limits per route behind this.
	# Not counted here: the 1С exchange (its own account, networks and limits; it polls hundreds of times a minute),
	# static files, health probes and the chat socket.
	rate_limit {
		zone renders {
			match {
				not path /api/* /ws* /_next/* /health/* /proxy-health /categories/* /brand/* /avatars/* /fonts/* /email/* /editorial/* *.png *.jpg *.webp *.avif *.svg *.ico *.woff2 *.webmanifest *.txt *.xml
				not header Next-Router-Prefetch 1
			}
			key {remote_host}
			ipv6_prefix 64
			events 60
			window 10s
		}
		zone api {
			match {
				path /api/*
				not path /api/v1/integrations/1c/*
			}
			key {remote_host}
			ipv6_prefix 64
			events 150
			window 10s
		}
	}

	# Optional password on the whole site (a closed test stand before launch).
	# Off unless SITE_PASSWORD_ENABLED=true. The 1С exchange keeps its own
	# login, password and IP allow-list in the same Authorization header, and
	# health probes and the chat socket carry no browser password prompt.
	@site_password {
		expression {$SITE_PASSWORD_ENABLED:false}
		not path /api/v1/integrations/1c/* /ws* /health/live /health/ready /proxy-health
	}
	basic_auth @site_password bcrypt "АН-30" {
		{$SITE_PASSWORD_USER} {$SITE_PASSWORD_HASH}
	}

	@api path /api/v1/* /ws*
	handle @api {
		reverse_proxy api:4000
	}

	@health path /health/live /health/ready
	handle @health {
		rewrite * /api/v1{uri}
		reverse_proxy api:4000
	}

	handle /proxy-health {
		respond "ok" 200
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https:; media-src 'self' blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ws: wss:; frame-src https://yandex.ru https://*.yandex.ru"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}

{$WWW_SITE_ADDRESS} {
	redir {$CANONICAL_ORIGIN:https://an30.ru}{uri} permanent
}

# Container-local liveness endpoint.
#
# The public site redirects HTTP to HTTPS, so probing it by loopback address
# fails TLS: the request carries no matching server name. This listener is
# bound inside the container, is never published, and answers regardless of
# which host name the deployment serves.
http://localhost:8080 {
	handle /proxy-health {
		respond "ok" 200
	}

	handle {
		respond 404
	}
}
