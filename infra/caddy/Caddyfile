{
	email {$ACME_EMAIL}
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip
	request_body {
		max_size 10MB
	}

	@api path /api/v1/* /ws*
	handle @api {
		reverse_proxy api:4000
	}

	@health path /health/live /health/ready
	handle @health {
		rewrite * /api/v1{uri}
		reverse_proxy api:4000
	}

	handle /proxy-health {
		respond "ok" 200
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ws: wss:; frame-src https://yandex.ru https://*.yandex.ru"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}

{$WWW_SITE_ADDRESS} {
	redir {$CANONICAL_ORIGIN:https://an30.ru}{uri} permanent
}

# Container-local liveness endpoint.
#
# The public site redirects HTTP to HTTPS, so probing it by loopback address
# fails TLS: the request carries no matching server name. This listener is
# bound inside the container, is never published, and answers regardless of
# which host name the deployment serves.
http://localhost:8080 {
	handle /proxy-health {
		respond "ok" 200
	}

	handle {
		respond 404
	}
}
