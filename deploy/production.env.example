# Production on the owner's VPS. Step-by-step instructions: docs/DEPLOY_VPS.md.
#
# Copy to /etc/an30/production.env on the server and replace every
# "your-domain.example" with the real domain. This file holds configuration
# only; every credential comes from Compose secrets in AN30_SECRETS_DIR and is
# never written here.
#
#   sudo AN30_SECRETS_DIR=/etc/an30/secrets \
#     docker compose --env-file /etc/an30/production.env up -d --build

# Marks the database and the API. The label becomes immutable inside PostgreSQL
# after the first migration: a database started as "staging" can never become
# "production", so choose it before the first start.
DEPLOYMENT_ENVIRONMENT=production

# Public origin, with https:// and without a trailing slash. Drives canonical
# links, the sitemap, CORS, the session cookie origin check, links in e-mails
# and the Яндекс ID / VK ID redirect addresses. The web image bakes it in at
# build time, so changing it requires "up -d --build".
APP_BASE_URL=https://your-domain.example

# Bare host name, no scheme: Caddy then obtains a certificate, serves HTTPS and
# redirects plain HTTP to it. The DNS A record must already point to the server.
SITE_ADDRESS=your-domain.example

# With a DNS record for www: "www.your-domain.example" (redirects to the main
# host over HTTPS). Without one keep the http:// form so Caddy does not request
# a certificate for a host that does not resolve.
WWW_SITE_ADDRESS=http://www.your-domain.example

# Reachable mailbox for the certificate authority.
ACME_EMAIL=admin@your-domain.example

# Checkout creates a заявка (manager request), no payment gateway. Both stay
# false until the owner approves the legal texts
# (docs/PRODUCTION_LEGAL_CHECKLIST.md). The API refuses to start with
# ENABLE_PUBLIC_CHECKOUT=true while LEGAL_DOCUMENTS_APPROVED is false.
ENABLE_PUBLIC_CHECKOUT=false
LEGAL_DOCUMENTS_APPROVED=false

# Mail (registration, password recovery, staff invitations). The worker always
# connects encrypted: port 587 with SMTP_SECURE=false (STARTTLS) or port 465
# with SMTP_SECURE=true.
#
# Yandex Cloud Postbox — everything below is already filled in for it; what is
# left is to paste the two parts of the key (docs/DEPLOY_VPS.md, «Почта»):
#   SMTP_USER  — the id of the API key of the service account (scope
#                yc.postbox.send, role postbox.sender)
#   the secret part of that key — into AN30_SECRETS_DIR/smtp_password.txt
#   SMTP_FROM  — an address on the domain confirmed in Postbox (DKIM record)
# then SMTP_ENABLED=true and restart the worker.
SMTP_ENABLED=false
SMTP_HOST=postbox.cloud.yandex.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_FROM_NAME=АН-30
SMTP_USER=

# Staff notifications. Tokens: telegram_bot_token.txt / vk_access_token.txt.
TELEGRAM_ENABLED=false
TELEGRAM_CHAT_ID=
VK_ENABLED=false
VK_PEER_ID=

# Customer login through Яндекс ID / VK ID. Empty = the button is hidden; it
# also needs LEGAL_DOCUMENTS_APPROVED=true. Redirect addresses to register:
#   https://your-domain.example/api/v1/auth/social/yandex/callback
#   https://your-domain.example/api/v1/auth/social/vk/callback
YANDEX_ID_CLIENT_ID=
VK_ID_CLIENT_ID=

# 1C price type shown on the site, by its exact 1C name (main / second base).
# Empty: a selling type is picked (the one with «розн» in its name, else the first listed);
# a cost type («Учетная», «Закупочная») is never taken (docs/ONE_C_SETUP_UNF.md, section 5.2).
ONE_C_PRICE_TYPE=
ONE_C_PRICE_TYPE_SECONDARY=

# «Подбор по автомобилю» (docs/PARTS_FINDER.md). The FAPI key is the only
# content of AN30_SECRETS_DIR/fapi_key.txt; an empty file switches FAPI off and
# the rest of the finder keeps working.
PARTS_FINDER_ENABLED=true
FAPI_FITMENT_ENABLED=false
FAPI_DAILY_CREDIT_LIMIT=1000
# One visitor's share of the day's credits (by address). Beyond it the finder answers that visitor from the shop's own data.
FAPI_VISITOR_DAILY_CREDIT_LIMIT=100
API_NINJAS_MODE=off

# Rossko supplier search ("под заказ"). Keys: rossko_key1.txt / rossko_key2.txt.
# The API refuses to start with ROSSKO_ENABLED=true and an empty key file.
ROSSKO_ENABLED=false
ROSSKO_DELIVERY_ID=000000001
# Retail margin in percent added to every supplier price on the server.
SUPPLIER_MARKUP_PERCENT=30

# Optional external catalog identity checks for staff. Key: reefapi_key.txt.
REEFAPI_ENABLED=false
REEFAPI_MARKET=de
REEFAPI_DAILY_CREDITS=30

# Gemini-backed chat assistant. Key: gemini_api_key.txt. The API refuses to
# start with AI_ENABLED=true and an empty key file.
AI_ENABLED=false
AI_MODEL=gemini-2.5-flash

# Закрытый стенд: один логин и пароль на весь сайт (обмен с 1С и проверки
# состояния под него не попадают). Хеш создаётся командой
#   docker run --rm caddy:2.11.9-alpine caddy hash-password --algorithm bcrypt --bcrypt-cost 10
# и записывается В ОДИНАРНЫХ КАВЫЧКАХ. Стоимость 10, не выше: при большей каждая попытка с
# неверным паролем стоит серверу секунды процессора (SECURITY.md).
SITE_PASSWORD_ENABLED=false
SITE_PASSWORD_USER=an30
# SITE_PASSWORD_HASH='$2a$10$...'

# Оставьте true. false нужен только пока сайт открыт по IP без HTTPS.
COOKIE_SECURE=true

# TecDoc (tecdoc.site) — каталог автомобилей и применимости, см. docs/TECDOC.md.
# Ключ кладётся в файл секрета tecdoc_api_key.txt; без ключа сайт работает на своём справочнике.
TECDOC_ENABLED=true
# Купленный пакет (запросов на 30 дней) и дата его покупки (ГГГГ-ММ-ДД).
TECDOC_MONTHLY_LIMIT=150000
TECDOC_PERIOD_START=
# 0 = автоматически: остаток пакета делится поровну на оставшиеся дни; в час не больше пятой части дня.
# Для тестового ключа (500 запросов в сутки) поставьте TECDOC_DAILY_LIMIT=450.
TECDOC_DAILY_LIMIT=0
TECDOC_HOURLY_LIMIT=0
# Сколько запросов к каталогу может вызвать один посетитель за сутки.
TECDOC_VISITOR_DAILY_LIMIT=150
# Кеш показа: по умолчанию сутки и не больше 20 000 ответов. Увеличивать только с письменного согласия tecdoc.site.
TECDOC_CACHE_TTL_SECONDS=86400
TECDOC_CACHE_MAX_ENTRIES=20000
