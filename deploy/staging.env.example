# Closed staging on the project VPS.
#
# Copy to /etc/an30/staging.env on the server. This file holds configuration
# only; every credential comes from Compose secrets in AN30_SECRETS_DIR and is
# never written here.
#
#   docker compose --env-file /etc/an30/staging.env up -d --build

# Marks the database and the API. The label becomes immutable inside PostgreSQL
# after the first migration, so a staging volume can never be promoted silently.
DEPLOYMENT_ENVIRONMENT=staging

# Public origin. Drives canonical links, the sitemap, CORS and the session
# cookie origin check.
APP_BASE_URL=https://staging.an30.ru

# Caddy terminates TLS for this host and obtains a real certificate.
SITE_ADDRESS=staging.an30.ru

# Served over plain HTTP so Caddy does not request a second certificate for a
# host that has no DNS record.
WWW_SITE_ADDRESS=http://www.staging.an30.ru

# Reachable mailbox for the certificate authority.
ACME_EMAIL=admin@an30.ru

# Staging exercises the full order flow: checkout creates a заявка (manager
# request) with no payment gateway involved.
ENABLE_PUBLIC_CHECKOUT=true

# Staging-only test setting, not a legal statement.
#
# The flag unlocks the checkout and the contact forms so the order flow can be
# exercised end to end on a closed, noindex environment. The published legal
# texts are still drafts awaiting the owner's approval. Do not copy this
# value into a production environment file before the texts are approved.
LEGAL_DOCUMENTS_APPROVED=true

# Optional adapters stay disabled until real credentials exist.
#
# Mail (registration, password recovery, staff invitations). The worker always
# connects encrypted: port 587 with SMTP_SECURE=false (STARTTLS) or port 465
# with SMTP_SECURE=true.
#
# Yandex Cloud Postbox — everything below is already filled in for it; what is
# left is to paste the two parts of the key (docs/DEPLOY_VPS.md, «Почта»):
#   SMTP_USER  — the id of the API key of the service account (scope
#                yc.postbox.send, role postbox.sender)
#   the secret part of that key — into AN30_SECRETS_DIR/smtp_password.txt
#   SMTP_FROM  — an address on the domain confirmed in Postbox (DKIM record)
# then SMTP_ENABLED=true and restart the worker.
SMTP_ENABLED=false
SMTP_HOST=postbox.cloud.yandex.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_FROM_NAME=АН-30
SMTP_USER=
TELEGRAM_ENABLED=false
VK_ENABLED=false

# Customer login through Яндекс ID / VK ID. Empty = the button is hidden.
# Redirect addresses to register with the providers:
#   <APP_BASE_URL>/api/v1/auth/social/yandex/callback
#   <APP_BASE_URL>/api/v1/auth/social/vk/callback
YANDEX_ID_CLIENT_ID=
VK_ID_CLIENT_ID=

# Rossko supplier search ("под заказ"). Disabled until real API keys exist;
# the shop's own catalog and checkout are unaffected either way (ADR-004).
ROSSKO_ENABLED=false
ROSSKO_DELIVERY_ID=000000001
# Retail margin in percent added to every supplier price on the server.
SUPPLIER_MARKUP_PERCENT=30
REEFAPI_ENABLED=false
REEFAPI_MARKET=de
REEFAPI_DAILY_CREDITS=30
# 1C price type shown on the site, by its exact 1C name (main / second base).
# Empty: a selling type is picked (the one with «розн» in its name, else the first listed);
# a cost type («Учетная», «Закупочная») is never taken (docs/ONE_C_SETUP_UNF.md, section 5.2).
ONE_C_PRICE_TYPE=
ONE_C_PRICE_TYPE_SECONDARY=

# «Подбор по автомобилю» (docs/PARTS_FINDER.md). The FAPI key is the only
# content of AN30_SECRETS_DIR/fapi_key.txt; an empty file switches FAPI off
# and the rest of the finder keeps working.
PARTS_FINDER_ENABLED=true
FAPI_FITMENT_ENABLED=false
FAPI_DAILY_CREDIT_LIMIT=1000
# One visitor's share of the day's credits (by address). Beyond it the finder answers that visitor from the shop's own data.
FAPI_VISITOR_DAILY_CREDIT_LIMIT=100
API_NINJAS_MODE=off

# Gemini-backed chat assistant. Disabled until the owner supplies a real API
# key in AN30_SECRETS_DIR/gemini_api_key.txt; chat still works fully with a
# human manager either way (ADR-004), and catalog search ranking never
# changes based on this flag (ADR-016).
AI_ENABLED=false
AI_MODEL=gemini-2.5-flash

# TecDoc (tecdoc.site) — каталог автомобилей и применимости, см. docs/TECDOC.md.
# Ключ кладётся в файл секрета tecdoc_api_key.txt; без ключа сайт работает на своём справочнике.
TECDOC_ENABLED=true
# Купленный пакет (запросов на 30 дней) и дата его покупки (ГГГГ-ММ-ДД).
TECDOC_MONTHLY_LIMIT=150000
TECDOC_PERIOD_START=
# 0 = автоматически: остаток пакета делится поровну на оставшиеся дни; в час не больше пятой части дня.
# Для тестового ключа (500 запросов в сутки) поставьте TECDOC_DAILY_LIMIT=450.
TECDOC_DAILY_LIMIT=0
TECDOC_HOURLY_LIMIT=0
# Сколько запросов к каталогу может вызвать один посетитель за сутки.
TECDOC_VISITOR_DAILY_LIMIT=150
# Кеш показа: по умолчанию сутки и не больше 20 000 ответов. Увеличивать только с письменного согласия tecdoc.site.
TECDOC_CACHE_TTL_SECONDS=86400
TECDOC_CACHE_MAX_ENTRIES=20000
